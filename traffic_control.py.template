def max_gb(account: Dict[str, Any]) -> float:
    return safe_float(account.get('max_traffic_gb'), DEFAULT_MAX_TRAFFIC_GB)


def traffic_text(traffic: Optional[float]) -> str:
    return '查询失败' if traffic is None else f'{traffic} GB'


def traffic_with_limit_text(account: Dict[str, Any], traffic: Optional[float]) -> str:
    if traffic is None:
        return f'查询失败 / {max_gb(account):g} GB'
    return f'{traffic} GB / {max_gb(account):g} GB'


def traffic_control_badge(account: Dict[str, Any], traffic: Optional[float]) -> str:
    if traffic is None:
        return '🟡 查询失败'
    limit = max_gb(account)
    if traffic >= limit:
        return '🔴 超限'
    if limit > 0 and traffic >= limit * 0.9:
        return '🟡 接近阈值'
    return '🟢 正常'


def instance_status_badge(status: str) -> str:
    status_s = str(status or 'Unknown')
    status_l = status_s.lower()
    if status_l == 'running':
        return '🟢 Running'
    if status_l == 'stopped':
        return '⚫ Stopped'
    if status_l == 'starting':
        return '🟡 Starting'
    if status_l == 'stopping':
        return '🟡 Stopping'
    if status_l == 'unknown':
        return '🔴 Unknown'
    return f'🔴 {status_s}'


def keepalive_badge(account: Dict[str, Any], instance_status: str) -> str:
    if not account_keepalive_enabled(account):
        return '🟡 已暂停'
    status_l = str(instance_status or 'Unknown').lower()
    if status_l == 'running':
        return '🟢 正常'
    if status_l in ['starting', 'stopping']:
        return '🟡 等待稳定'
    if has_notify_key(account, 'traffic_stop'):
        return '⚫ 熔断停机'
    if has_notify_key(account, 'manual_stop'):
        return '⚫ 手动停机'
    return '🔴 异常'


def account_runtime_status(account: Dict[str, Any], instance_status: Optional[str] = None) -> str:
    """给 cdt 首页和通知用的人话状态。
    traffic_stop/manual_stop 只记录本程序触发的原因；如果用户在阿里云后台关机，显示为未知原因关机。
    """
    if instance_status is None:
        instance_status = get_vps_status(account)
    status_l = str(instance_status or 'Unknown').lower()

    if status_l == 'running':
        return '机器在线运行中'
    if status_l == 'starting':
        return '正在开机中'
    if status_l == 'stopping':
        return '正在关机中'
    if has_notify_key(account, 'traffic_stop'):
        return '流量达到阈值已关机'
    if has_notify_key(account, 'manual_stop'):
        return '手动关机'
    if status_l == 'stopped':
        if not account_keepalive_enabled(account):
            return '已关机（保活关闭）'
        return '已关机（外部/未知原因）'
    return f'状态未知：{instance_status}'


