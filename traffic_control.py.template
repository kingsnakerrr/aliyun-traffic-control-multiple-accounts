@run_async
def ip_callback(update: Update, context: CallbackContext):
    if not is_admin(update):
        return
    query = update.callback_query
    query.answer()
    action = query.data
    if action == 'ip:cancel':
        context.user_data.pop('ip_setup', None)
        context.user_data.pop('ip_targets', None)
        context.user_data.pop('ip_bulk', None)
        context.user_data.pop('ip_edit', None)
        query.message.reply_text('已取消换 IP。')
        return
    if action == 'ip:configlist':
        context.user_data.pop('ip_setup', None)
        context.user_data.pop('ip_targets', None)
        context.user_data.pop('ip_bulk', None)
        context.user_data.pop('ip_edit', None)
        accounts = load_accounts(include_disabled=True)
        query.message.reply_text('选择要修改 Cloudflare 配置的账号：',
                                 reply_markup=cf_config_keyboard(accounts))
        return
    if action.startswith('ip:config:') and action[10:].isdigit():
        context.user_data.pop('ip_setup', None)
        context.user_data.pop('ip_targets', None)
        context.user_data.pop('ip_bulk', None)
        context.user_data.pop('ip_edit', None)
        show_cf_config_panel(context, query.message.chat_id, int(action[10:]))
        return
    if action.startswith('ip:field:'):
        parts = action.split(':')
        if len(parts) == 4 and parts[2].isdigit() and parts[3] in CF_FIELD_CODES:
            accounts = load_accounts(include_disabled=True)
            index = int(parts[2])
            if 0 <= index < len(accounts):
                field = CF_FIELD_CODES[parts[3]]
                context.user_data.pop('ip_setup', None)
                context.user_data.pop('ip_targets', None)
                context.user_data.pop('ip_bulk', None)
                context.user_data['ip_edit'] = {'key': account_key(accounts[index]), 'field': field}
                query.message.reply_text(f'账号：{account_name(accounts[index])}\n{CF_SETUP_PROMPTS[field]}\n发送 /cancel 可取消。')
                return
        query.message.reply_text('账号列表已变化，请重新发送 /cfconfig。')
        return
    if action.startswith('ip:verify:') and action[10:].isdigit():
        accounts = load_accounts(include_disabled=True)
        index = int(action[10:])
        if not 0 <= index < len(accounts):
            query.message.reply_text('账号列表已变化，请重新发送 /cfconfig。')
            return
        account = accounts[index]
        try:
            zone = verify_cf_zone(account)
            cf_record(account)
            query.message.reply_text(f'✅ {account_name(account)}：Cloudflare 区域 {zone}、令牌和 DNS 读取均正常。未执行换 IP。')
        except Exception as exc:
            query.message.reply_text(f'❌ {account_name(account)}：{exc}\n未执行换 IP，可点上方按钮修改配置。')
        return
    if action == 'ip:confirm':
        keys = context.user_data.pop('ip_targets', None)
        bulk = context.user_data.pop('ip_bulk', False)
        if not keys:
            query.message.reply_text('操作已过期，请重新发送 /changeip。')
            return
        context.user_data.pop('ip_setup', None)
        accounts = [find_account(key, include_disabled=True) for key in keys]
        domains = [str(acc.get('cf_domain') or '').lower() for acc in accounts if acc]
        if len(domains) != len(set(domains)) or len(keys) != len(set(keys)):
            query.message.reply_text('多个账号使用了相同实例或 CF 域名，请先分别配置，已取消本次操作。')
            return
        query.message.reply_text('开始换 IP，请等待逐台处理结果；期间不要重复点击。')
        try:
            with ip_rotation_lock():
                for key in keys:
                    account = find_account(key, include_disabled=True)
                    if not account:
                        result = f'❌ 账号 {key} 已被删除，跳过。'
                    elif bulk and not account_enabled(account):
                        result = f'⏭ {account_name(account)}：账号已禁用，跳过。'
                    else:
                        if bulk:
                            try:
                                preflight_rotation(account, require_record=True)
                            except ValueError as exc:
                                query.message.reply_text(f'⏭ {account_name(account)}：配置或状态已变化，预检未通过：{exc}')
                                continue
                            except Exception:
                                logging.exception('确认后批量预检失败：%s', account_name(account))
                                query.message.reply_text(f'⏭ {account_name(account)}：预检查询失败，已跳过。')
                                continue
                        try:
                            result = rotate_one_eip(account)
                        except RuntimeError as exc:
                            logging.exception('换 IP 失败：%s', account_name(account))
                            query.message.reply_text(f'❌ {account_name(account)}：{exc}')
                            query.message.reply_text('批量换 IP 已停止，请核查上一个账号状态后再操作。')
                            break
                        except Exception as exc:
                            logging.exception('换 IP 失败：%s', account_name(account))
                            result = f'❌ {account_name(account)}：{exc}'
                    query.message.reply_text(result)
        except ValueError as exc:
            query.message.reply_text(str(exc))
        return
    accounts = load_accounts(include_disabled=True)
    if action == 'ip:all':
        context.user_data.pop('ip_setup', None)
        context.user_data.pop('ip_targets', None)
        context.user_data.pop('ip_bulk', None)
        selected = []
        skipped = []
        seen_instances = set()
        seen_domains = set()
        for acc in accounts:
            if not account_enabled(acc):
                continue
            name = account_name(acc)
            instance = str(acc.get('instance_id') or '')
            domain = str(acc.get('cf_domain') or '').lower().rstrip('.')
            if instance in seen_instances or domain in seen_domains:
                skipped.append(f'• {name}：实例或 CF 域名与已选账号重复。')
                continue
            try:
                preflight_rotation(acc, require_record=True)
            except ValueError as exc:
                skipped.append(f'• {name}：{exc}')
                continue
            except Exception:
                logging.exception('批量换 IP 预检失败：%s', name)
                skipped.append(f'• {name}：预检查询失败，请检查阿里云/CF 权限、网络和服务日志。')
                continue
            selected.append(acc)
            seen_instances.add(instance)
            seen_domains.add(domain)
        prompt_bulk_confirmation(context, query.message.chat_id, selected, skipped)
        return
    elif action.startswith('ip:one:') and action[7:].isdigit():
        idx = int(action[7:])
        selected = [accounts[idx]] if 0 <= idx < len(accounts) else []
    else:
        selected = []
    if not selected:
        query.message.reply_text('没有可选账号，请重新发送 /changeip。')
        return
    keys = [account_key(acc) for acc in selected]
    context.user_data['ip_targets'] = keys
    context.user_data.pop('ip_bulk', None)
    context.user_data['ip_setup'] = {'keys': keys, 'index': 0}
    prompt_ip_setup(context, query.message.chat_id)


@run_async
def ip_setup_message(update: Update, context: CallbackContext):
    if not is_admin(update):
        return
    edit = context.user_data.get('ip_edit')
    if edit:
        account = find_account(edit['key'], include_disabled=True)
        if not account:
            context.user_data.pop('ip_edit', None)
            update.message.reply_text('账号已变化，请重新发送 /cfconfig。')
            return
        field = edit['field']
        if field == 'cf_api_token':
            try:
                update.message.delete()
            except Exception:
                update.message.reply_text('无法删除含令牌的消息，请手动删除并考虑更换令牌。')
        try:
            value = normalize_cf_input(field, update.message.text)
            save_cf_setting(account, field, value)
        except ValueError as exc:
            update.message.reply_text(f'{exc}\n请重新输入，或发送 /cancel 取消。')
            return
        context.user_data.pop('ip_edit', None)
        account = find_account(edit['key'], include_disabled=True)
        try:
            zone = verify_cf_zone(account)
            result = f'✅ 已保存，Cloudflare 区域 {zone} 与域名匹配。'
        except Exception as exc:
            result = f'已保存，但 Cloudflare 配置还未通过校验：{exc}'
        update.message.reply_text(result + '\n此操作没有更换 IP。')
        accounts = load_accounts(include_disabled=True)
        index = next((i for i, item in enumerate(accounts)
                      if account_key(item) == edit['key']), None)
        if index is not None:
            show_cf_config_panel(context, update.effective_chat.id, index)
        return
    state = context.user_data.get('ip_setup')
    if not state:
        return
    account = find_account(state['keys'][state['index']], include_disabled=True)
    if not account:
        context.user_data.pop('ip_setup', None)
        update.message.reply_text('账号已变化，请重新发送 /changeip。')
        return
    field = state['field']
    value = update.message.text.strip()
    if field == 'cf_api_token':
        try:
            update.message.delete()
        except Exception:
            update.message.reply_text('无法删除包含 Token 的消息，请手动删除并考虑更换 Token。')
    try:
        value = normalize_cf_input(field, value)
        save_cf_setting(account, field, value)
    except ValueError as exc:
        update.message.reply_text(f'{exc}\n请重新输入，或发送 /cancel 取消。')
        return
    prompt_ip_setup(context, update.effective_chat.id)


