def get_vps_status(account: Dict[str, Any]) -> str:
    instance_id = account.get('instance_id')
    if not instance_id:
        return 'Unknown'
    try:
        request = DescribeInstancesRequest.DescribeInstancesRequest()
        request.set_InstanceIds([instance_id])
        response = ecs_client(account).do_action_with_exception(request)
        data = json.loads(response.decode('utf-8'))
        instances = data.get('Instances', {}).get('Instance', [])
        if not instances:
            return 'Unknown'
        return instances[0].get('Status', 'Unknown')
    except Exception as e:
        logging.error(f'[{account_name(account)}] 查询实例状态失败: {str(e)}')
        return 'Unknown'


def start_vps_safety(account: Dict[str, Any]) -> Tuple[bool, str]:
    instance_id = account.get('instance_id')
    if not instance_id:
        return False, '❌ INSTANCE_ID 未配置'
    try:
        status = get_vps_status(account)
        status_l = status.lower()
        if status_l == 'running':
            return True, '✅ 实例已经是 Running，无需开机'
        if status_l == 'starting':
            return True, f'⏳ 实例当前是 {status}，正在启动中，等待恢复 Running'
        if status_l == 'stopping':
            return False, f'⏳ 实例当前是 {status}，正在关机中，等待状态稳定后再开机'
        if status_l == 'unknown':
            return False, '❌ 无法确认实例状态，已跳过开机，避免误操作'
        request = StartInstanceRequest.StartInstanceRequest()
        request.set_InstanceId(instance_id)
        ecs_client(account).do_action_with_exception(request)
        return True, '✅ StartInstance() 调用成功，实例正在启动'
    except Exception as e:
        logging.error(f'[{account_name(account)}] 开机失败: {str(e)}')
        return False, f'❌ 开机失败：{str(e)}'


def stop_vps_safety(account: Dict[str, Any]) -> Tuple[bool, str]:
    instance_id = account.get('instance_id')
    if not instance_id:
        return False, '❌ INSTANCE_ID 未配置'
    try:
        status = get_vps_status(account)
        status_l = status.lower()
        if status_l == 'stopped':
            return True, '✅ 实例已经是 Stopped，无需关机'
        if status_l == 'stopping':
            return True, f'⏳ 实例当前是 {status}，正在关机中'
        request = StopInstanceRequest.StopInstanceRequest()
        request.set_InstanceId(instance_id)
        request.set_ForceStop(True)
        ecs_client(account).do_action_with_exception(request)
        return True, '✅ StopInstance() 调用成功，实例正在关机'
    except Exception as e:
        logging.error(f'[{account_name(account)}] 关机失败: {str(e)}')
        return False, f'❌ 关机失败：{str(e)}'

