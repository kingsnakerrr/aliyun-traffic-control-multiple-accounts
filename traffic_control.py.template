def send_status_messages_to_tg(chat_id) -> int:
    accounts = load_accounts(include_disabled=True)
    if not accounts:
        send_tg(chat_id, '❌ 暂无账号，请先用 cdt -> 增加账号。')
        return 0
    sent = 0
    for acc in accounts:
        if send_tg(chat_id, build_status_text(acc)):
            sent += 1
    return sent


def send_status_messages_to_bot(bot, chat_id) -> int:
    accounts = load_accounts(include_disabled=True)
    if not accounts:
        bot.send_message(chat_id=chat_id, text='❌ 暂无账号，请先用 cdt -> 增加账号。')
        return 0
    sent = 0
    for acc in accounts:
        bot.send_message(chat_id=chat_id, text=build_status_text(acc))
        sent += 1
    return sent


