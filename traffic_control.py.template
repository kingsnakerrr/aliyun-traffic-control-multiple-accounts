def prompt_ip_setup(context: CallbackContext, chat_id):
    state = context.user_data['ip_setup']
    keys = state['keys']
    while state['index'] < len(keys):
        account = find_account(keys[state['index']], include_disabled=True)
        if not account:
            state['index'] += 1
            continue
        missing = [field for field in CF_SETUP_FIELDS if not account.get(field)]
        if missing:
            state['field'] = missing[0]
            context.bot.send_message(chat_id=chat_id, text=(
                f'账号：{account_name(account)}\n尚缺 Cloudflare 配置。\n'
                + CF_SETUP_PROMPTS[state['field']]
            ))
            return
        state['index'] += 1
    context.user_data.pop('ip_setup', None)
    for key in keys:
        account = find_account(key, include_disabled=True)
        if not account:
            continue
        try:
            verify_cf_zone(account)
        except Exception as exc:
            context.user_data.pop('ip_targets', None)
            accounts = load_accounts(include_disabled=True)
            index = next((i for i, item in enumerate(accounts) if account_key(item) == key), None)
            markup = InlineKeyboardMarkup([[
                InlineKeyboardButton('修改这个账号的 CF 配置', callback_data=f'ip:config:{index}')
            ]]) if index is not None else None
            context.bot.send_message(chat_id=chat_id, text=(
                f'{account_name(account)} 的 Cloudflare 配置校验失败：{exc}\n'
                '尚未申请或更换 EIP。请修改后重新发送 /changeip。'
            ), reply_markup=markup)
            return
    names = [account_name(find_account(key, include_disabled=True)) for key in keys
             if find_account(key, include_disabled=True)]
    context.bot.send_message(chat_id=chat_id, text=(
        '准备更换：' + '、'.join(names) + '\n'
        '会产生新 EIP 费用，解绑/绑定期间短暂断网；成功更新 CF 后才释放旧 EIP。\n确定执行？'
    ), reply_markup=InlineKeyboardMarkup([[
        InlineKeyboardButton('确认换 IP', callback_data='ip:confirm'),
        InlineKeyboardButton('取消', callback_data='ip:cancel')
    ]]))


def prompt_bulk_confirmation(context: CallbackContext, chat_id, accounts: List[Dict[str, Any]], skipped: List[str]):
    if skipped:
        context.bot.send_message(chat_id=chat_id, text='已跳过以下账号（不会进入配置流程）：\n' + '\n'.join(skipped))
    if not accounts:
        context.bot.send_message(chat_id=chat_id, text='没有预检通过的启用账号。请用 /cfconfig 修正配置，或用 /guide 下载教程。')
        return
    keys = [account_key(acc) for acc in accounts]
    context.user_data['ip_targets'] = keys
    context.user_data['ip_bulk'] = True
    names = '、'.join(account_name(acc) for acc in accounts)
    context.bot.send_message(chat_id=chat_id, text=(
        f'批量只读预检通过 {len(accounts)} 台：{names}\n'
        '预检无法验证 RAM 写入权限或 EIP 申请配额，实际执行仍可能失败。\n'
        '会产生新 EIP 费用，解绑/绑定期间短暂断网；成功更新 CF 后才释放旧 EIP。\n确定执行？'
    ), reply_markup=InlineKeyboardMarkup([[
        InlineKeyboardButton('确认换 IP', callback_data='ip:confirm'),
        InlineKeyboardButton('取消', callback_data='ip:cancel')
    ]]))


