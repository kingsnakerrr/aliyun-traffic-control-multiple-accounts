def selector_from_args(context: CallbackContext) -> Optional[str]:
    if context and context.args:
        return ' '.join(context.args).strip()
    return None


def vpc_action(account: Dict[str, Any], action: str, **params) -> Dict[str, Any]:
    request = CommonRequest()
    request.set_domain('vpc.aliyuncs.com')
    request.set_version('2016-04-28')
    request.set_action_name(action)
    request.set_method('POST')
    request.add_query_param('RegionId', account['region_id'])
    for key, value in params.items():
        request.add_query_param(key, str(value))
    response = ecs_client(account).do_action_with_exception(request)
    return json.loads(response.decode('utf-8'))


def describe_eip(account: Dict[str, Any], allocation_id: str) -> Optional[Dict[str, Any]]:
    data = vpc_action(account, 'DescribeEipAddresses', AllocationId=allocation_id)
    items = data.get('EipAddresses', {}).get('EipAddress', [])
    return items[0] if items else None


def current_eip(account: Dict[str, Any]) -> Dict[str, Any]:
    try:
        data = vpc_action(account, 'DescribeEipAddresses', AssociatedInstanceId=account['instance_id'],
                          AssociatedInstanceType='EcsInstance', PageSize=100)
    except Exception as exc:
        if 'Forbidden.RAM' in str(exc):
            raise ValueError('阿里云 RAM 用户无权查询 EIP。请在阿里云给该 AccessKey 所属 RAM 用户授予 vpc:DescribeEipAddresses 权限；换 IP 还需 EIP 的申请、解绑、绑定、释放权限。') from exc
        raise
    items = [e for e in data.get('EipAddresses', {}).get('EipAddress', [])
             if e.get('InstanceId') == account['instance_id'] and e.get('InstanceType') == 'EcsInstance']
    if len(items) != 1:
        raise ValueError('未找到唯一的直绑 ECS EIP。固定公网 IP、辅助网卡 EIP 暂不支持自动更换。')
    eip = items[0]
    if (eip.get('Status') != 'InUse' or eip.get('ChargeType') != 'PostPaid' or
            eip.get('BandwidthPackageId') or eip.get('DeletionProtection') or
            eip.get('PublicIpAddressPoolId') or eip.get('SegmentInstanceId') or
            eip.get('BizType', 'Default') != 'Default' or
            eip.get('BusinessStatus', 'Normal') != 'Normal' or
            eip.get('Mode', 'NAT') != 'NAT' or
            eip.get('ISP') not in ('BGP', 'BGP_PRO') or
            eip.get('InternetChargeType') not in ('PayByTraffic', 'PayByBandwidth') or
            (eip.get('SecurityProtectionTypes') or {}).get('SecurityProtectionType')):
        raise ValueError('当前 EIP 状态或计费配置不适合自动更换（仅支持未加入共享带宽的普通按量 EIP）。')
    if int(eip.get('Bandwidth') or 0) < 1:
        raise ValueError('无法读取旧 EIP 带宽，已停止。')
    return eip


def wait_eip(account: Dict[str, Any], allocation_id: str, status: str,
             instance_id: Optional[str] = None) -> Dict[str, Any]:
    for _ in range(24):
        eip = describe_eip(account, allocation_id)
        if eip and eip.get('Status') == status and (
                instance_id is None or eip.get('InstanceId') == instance_id):
            return eip
        time.sleep(5)
    raise TimeoutError(f'EIP {allocation_id} 未在 120 秒内进入 {status}，请到阿里云控制台检查。')


def cf_request(account: Dict[str, Any], method: str, path: str, **kwargs) -> Dict[str, Any]:
    zone_id = account['cf_zone_id']
    url = f'https://api.cloudflare.com/client/v4/zones/{zone_id}'
    if path:
        url += f'/{path}'
    response = requests.request(
        method, url,
        headers={'Authorization': f'Bearer {account["cf_api_token"]}'},
        timeout=20, **kwargs
    )
    data = response.json()
    if not response.ok or not data.get('success'):
        errors = ', '.join(str(e.get('message', '未知错误')) for e in data.get('errors', []))
        raise ValueError(f'Cloudflare API 失败：{errors or response.status_code}')
    return data


def cf_record(account: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    domain = account['cf_domain'].lower().rstrip('.')
    data = cf_request(account, 'GET', 'dns_records', params={
        'type': 'A', 'name.exact': domain, 'per_page': 100
    })
    records = [r for r in data.get('result', [])
               if r.get('type') == 'A' and r.get('name', '').lower().rstrip('.') == domain]
    if len(records) > 1:
        raise ValueError(f'{domain} 有多个 A 记录，无法安全确认要更新哪一个。')
    return records[0] if records else None


def validate_cf_config(account: Dict[str, Any]):
    domain = str(account.get('cf_domain') or '').lower().rstrip('.')
    zone_id = str(account.get('cf_zone_id') or '')
    if not re.fullmatch(r'[a-z0-9-]+(?:\.[a-z0-9-]+)+', domain) or len(domain) > 253:
        raise ValueError('Cloudflare 域名格式不正确。')
    if not re.fullmatch(r'[a-fA-F0-9]{32}', zone_id):
        raise ValueError('Cloudflare Zone ID 应为 32 位十六进制字符串。')
    if not str(account.get('cf_api_token') or '').strip():
        raise ValueError('请先设置 Cloudflare API Token。')


def verify_cf_zone(account: Dict[str, Any]) -> str:
    validate_cf_config(account)
    try:
        zone = cf_request(account, 'GET', '').get('result') or {}
    except Exception as exc:
        raise ValueError(f'无法验证 Cloudflare 区域 ID 和 Token：{exc}。请确认填的是“区域 ID”，不是“账户 ID”。') from exc
    zone_name = str(zone.get('name') or '').lower().rstrip('.')
    domain = str(account['cf_domain']).lower().rstrip('.')
    if not zone_name or not (domain == zone_name or domain.endswith('.' + zone_name)):
        raise ValueError(f'域名 {domain} 不属于该 Cloudflare 区域 {zone_name or "未知"}，请检查区域 ID 和域名。')
    return zone_name


def preflight_rotation(account: Dict[str, Any], require_record: bool = False) -> Tuple[Dict[str, Any], Optional[Dict[str, Any]]]:
    missing = validate_account(account)
    if missing:
        raise ValueError('阿里云账号配置缺少：' + ', '.join(missing))
    verify_cf_zone(account)
    old = current_eip(account)
    record = cf_record(account)
    if record and record.get('content') != old['IpAddress']:
        raise ValueError(f'{account["cf_domain"]} 当前解析与旧 EIP {old["IpAddress"]} 不一致，已停止以防改错记录。')
    if require_record and not record:
        raise ValueError('Cloudflare 中没有该域名的 A 记录；批量模式不会自动创建，请先在 CF 配置并验证。')
    return old, record


@contextmanager
def ip_rotation_lock():
    ensure_base_dir()
    with open(IP_ROTATION_LOCK_FILE, 'a', encoding='utf-8') as lock_file:
        os.chmod(IP_ROTATION_LOCK_FILE, 0o600)
        if fcntl:
            try:
                fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError('已有换 IP 任务正在执行，请等待完成。')
        try:
            yield
        finally:
            if fcntl:
                fcntl.flock(lock_file, fcntl.LOCK_UN)


def rotate_one_eip(account: Dict[str, Any]) -> str:
    old, record = preflight_rotation(account)
    old_id, old_ip = old['AllocationId'], old['IpAddress']
    if not record:
        data = cf_request(account, 'POST', 'dns_records', json={
            'type': 'A', 'name': account['cf_domain'], 'content': old_ip,
            'ttl': 120, 'proxied': False
        })
        record = data['result']
    new_id = None
    phase = 'preflight'
    try:
        allocated = vpc_action(account, 'AllocateEipAddress',
                               Bandwidth=old['Bandwidth'], ISP=old['ISP'],
                               InstanceChargeType='PostPaid',
                               InternetChargeType=old['InternetChargeType'],
                               **({'ResourceGroupId': old['ResourceGroupId']}
                                  if old.get('ResourceGroupId') else {}))
        new_id = allocated['AllocationId']
        phase = 'allocated'
        new_ip = allocated['EipAddress']
        ipaddress.IPv4Address(new_ip)
        wait_eip(account, new_id, 'Available')
        phase = 'unbinding'
        vpc_action(account, 'UnassociateEipAddress', AllocationId=old_id, InstanceId=account['instance_id'])
        wait_eip(account, old_id, 'Available')
        phase = 'unbound'
        phase = 'binding'
        vpc_action(account, 'AssociateEipAddress', AllocationId=new_id,
                   InstanceId=account['instance_id'], InstanceType='EcsInstance')
        wait_eip(account, new_id, 'InUse', account['instance_id'])
        phase = 'bound'
        cf_request(account, 'PATCH', f'dns_records/{record["id"]}', json={'content': new_ip})
        phase = 'dns_updated'
        if cf_record(account).get('content') != new_ip:
            raise ValueError('Cloudflare 更新后回读的 IP 不一致。')
        vpc_action(account, 'ReleaseEipAddress', AllocationId=old_id)
        return f'✅ {account_name(account)}：{old_ip} → {new_ip}\nCF：{account["cf_domain"]} 已更新，旧 EIP 已释放。'
    except Exception as exc:
        detail = str(exc)
        recovered = False
        if phase == 'binding':
            try:
                new_state = describe_eip(account, new_id)
                if new_state and new_state.get('Status') == 'InUse' and new_state.get('InstanceId') == account['instance_id']:
                    phase = 'bound'
                elif new_state and new_state.get('Status') == 'Available':
                    phase = 'unbound'
            except Exception:
                pass
        if phase == 'unbound':
            try:
                vpc_action(account, 'AssociateEipAddress', AllocationId=old_id,
                           InstanceId=account['instance_id'], InstanceType='EcsInstance')
                wait_eip(account, old_id, 'InUse', account['instance_id'])
                detail += '；旧 EIP 已重新绑定。'
                recovered = True
            except Exception as rollback_exc:
                detail += f'；旧 EIP 回绑失败：{rollback_exc}'
        if new_id and (phase == 'allocated' or recovered):
            try:
                if describe_eip(account, new_id).get('Status') == 'Available':
                    vpc_action(account, 'ReleaseEipAddress', AllocationId=new_id)
                    detail += '；闲置新 EIP 已释放。'
            except Exception as release_exc:
                detail += f'；新 EIP 释放失败：{release_exc}'
        if new_id:
            detail += f'；新 EIP：{new_id}。'
        if phase in ('bound', 'dns_updated'):
            detail += '新 EIP 已绑定，旧 EIP 保留未释放，请核对 DNS 和费用。'
        elif phase in ('unbinding', 'binding'):
            detail += 'EIP 状态仍在变化，请先到阿里云控制台核查绑定，勿重复执行。'
        raise RuntimeError(detail) from exc


CF_SETUP_FIELDS = ('cf_domain', 'cf_zone_id', 'cf_api_token')
CF_SETUP_PROMPTS = {
    'cf_domain': '请输入这台机器对应的完整域名，例如 hk.example.com：',
    'cf_zone_id': '请输入 Cloudflare Zone ID（32 位，可在域名概览页找到）：',
    'cf_api_token': '请输入仅授权目标区域 DNS 编辑的 Cloudflare API Token（不是 Global API Key）。发送后机器人会尽量删除这条消息：',
}
CF_FIELD_CODES = {'domain': 'cf_domain', 'zone': 'cf_zone_id', 'token': 'cf_api_token'}


def normalize_cf_input(field: str, value: str) -> str:
    value = value.strip()
    if field == 'cf_domain':
        value = value.lower().rstrip('.')
        if not re.fullmatch(r'[a-z0-9-]+(?:\.[a-z0-9-]+)+', value) or len(value) > 253:
            raise ValueError('域名格式不正确，请输入完整域名，例如 abc.222321.xyz。')
    elif field == 'cf_zone_id' and not re.fullmatch(r'[a-fA-F0-9]{32}', value):
        raise ValueError('区域 ID 应为 32 位字符串。请复制域名概览页的“区域 ID”，不要填“账户 ID”。')
    elif field == 'cf_api_token' and (not value or len(value) > 512):
        raise ValueError('API 令牌为空或过长，请重新输入。')
    return value


def save_cf_setting(account: Dict[str, Any], field: str, value: str):
    accounts = load_accounts(include_disabled=True)
    for item in accounts:
        if account_key(item) == account_key(account):
            item[field] = value
            save_accounts(accounts)
            return
    raise ValueError('账号已变化，请重新选择。')


