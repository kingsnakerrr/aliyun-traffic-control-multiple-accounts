def register_bot_menu():
    commands = [
        {'command': 'status', 'description': '查看所有账号状态'},
        {'command': 'traffic', 'description': '查看 CDT 流量'},
        {'command': 'bill', 'description': '查看余额和本月消费'},
        {'command': 'report', 'description': '立即发送所有账号报告'},
        {'command': 'startvps', 'description': '启动指定账号实例'},
        {'command': 'stopvps', 'description': '停止指定账号实例'},
        {'command': 'keepon', 'description': '开启指定账号保活'},
        {'command': 'keepoff', 'description': '关闭指定账号保活'},
        {'command': 'changeip', 'description': '选择账号更换 EIP 并更新 CF'},
        {'command': 'cfconfig', 'description': '修改并验证 Cloudflare 配置'},
        {'command': 'guide', 'description': '下载完整操作教程'},
        {'command': 'cancel', 'description': '取消当前配置输入'},
        {'command': 'help', 'description': '查看命令说明'},
    ]
    base = f'https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}'
    scopes = [{'type': 'default'}, {'type': 'chat', 'chat_id': int(ADMIN_USER_ID)}]
    for scope in scopes:
        for language in (('', 'zh', 'en') if scope['type'] == 'chat' else ('',)):
            try:
                response = requests.post(f'{base}/setMyCommands', json={
                    'commands': commands, 'scope': scope, 'language_code': language
                }, timeout=10)
                if not response.ok or not response.json().get('ok'):
                    logging.warning('设置 TG 命令菜单失败：%s', response.text)
            except Exception as exc:
                logging.warning('设置 TG 命令菜单失败：%s', type(exc).__name__)
    try:
        response = requests.post(f'{base}/setChatMenuButton', json={
            'chat_id': int(ADMIN_USER_ID), 'menu_button': {'type': 'commands'}
        }, timeout=10)
        if not response.ok or not response.json().get('ok'):
            logging.warning('设置 TG 菜单按钮失败：%s', response.text)
    except Exception as exc:
        logging.warning('设置 TG 菜单按钮失败：%s', type(exc).__name__)

# =========================
# 主入口
# =========================

def main():
    ensure_base_dir()

    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == '--cron':
            check_cron_job()
            return
        if cmd == '--report':
            send_report_now()
            return
        if cmd == '--list-accounts':
            list_accounts_cli()
            return
        if cmd == '--account-count':
            account_count_cli()
            return
        if cmd == '--add-account':
            add_account_cli()
            return
        if cmd == '--delete-account':
            delete_account_cli()
            return
        if cmd == '--edit-account':
            edit_account_cli()
            return
        if cmd == '--enable-account':
            set_account_enabled_cli(True)
            return
        if cmd == '--disable-account':
            set_account_enabled_cli(False)
            return
        if cmd == '--enable-keepalive-account':
            set_account_keepalive_cli(True)
            return
        if cmd == '--disable-keepalive-account':
            set_account_keepalive_cli(False)
            return
        if cmd == '--status-account':
            status_account_cli()
            return
        if cmd == '--report-account':
            report_account_cli()
            return
        if cmd == '--start-account':
            start_account_cli()
            return
        if cmd == '--stop-account':
            stop_account_cli()
            return
        if cmd == '--cron-account':
            cron_account_cli()
            return
        if cmd == '--status-all':
            print(build_all_status_text())
            return

    if not os.path.exists(KEEPALIVE_FLAG_FILE):
        set_keepalive_enabled(True)

    accounts = load_accounts(include_disabled=True)
    if not accounts:
        logging.warning('暂无账号。请运行 cdt -> 多账号管理 -> 增加账号。')

    updater = Updater(
        TELEGRAM_BOT_TOKEN,
        workers=4,
        request_kwargs={'read_timeout': 10, 'connect_timeout': 10}
    )

    dispatcher = updater.dispatcher
    dispatcher.add_handler(CommandHandler('help', help_command))
    dispatcher.add_handler(CommandHandler('guide', guide_command))
    dispatcher.add_handler(CommandHandler('status', status_command))
    dispatcher.add_handler(CommandHandler('traffic', traffic_command))
    dispatcher.add_handler(CommandHandler('bill', bill_command))
    dispatcher.add_handler(CommandHandler('startvps', startvps_command))
    dispatcher.add_handler(CommandHandler('stopvps', stopvps_command))
    dispatcher.add_handler(CommandHandler('keepon', keepon_command))
    dispatcher.add_handler(CommandHandler('keepoff', keepoff_command))
    dispatcher.add_handler(CommandHandler('report', report_command))
    dispatcher.add_handler(CommandHandler('changeip', changeip_command))
    dispatcher.add_handler(CommandHandler('cfconfig', cfconfig_command))
    dispatcher.add_handler(CommandHandler('cancel', cancel_command))
    dispatcher.add_handler(CallbackQueryHandler(ip_callback, pattern=r'^ip:'))
    dispatcher.add_handler(MessageHandler(Filters.text & ~Filters.command, ip_setup_message))

    register_bot_menu()
    updater.start_polling(clean=True)
    logging.info('Telegram Bot 已启动：多账号模式，日报由 cron 按北京时间判断发送。')
    updater.idle()


if __name__ == '__main__':
    try:
        main()
    except UserCancelled:
        pass
    except KeyboardInterrupt:
        print('\n已取消当前操作，返回菜单。')
